b) Grouped Frequency distribution
import pandas as pd
import matplotlib.pyplot as plt
df = pd.DataFrame({
    'ID': ['1', '1', '2', '3', '4'],
    'Product_Name': ['CS', 'SE', 'SE', 'SE', 'CS'],
    'State': [60, 70, 59, 51, 80],
    'Salescount': [20, 21, 20, 22, 23]
})
display(df)
df.groupby('ID')['Salescount'].max().plot(kind='bar', legend=True)
plt.show()
 
